<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>🌸 Chizuru Sales 🌸</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    body {
      font-family: Arial, sans-serif;
      background: #f9f9f9;
      color: #333;
    }
    header {
      background: #5e2d91;
      color: white;
      padding: 15px 30px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
    }
    header h1 {
      font-size: 22px;
    }
    header input {
      padding: 8px;
      border-radius: 6px;
      border: none;
      width: 250px;
      max-width: 100%;
    }
    nav {
      background: #fff;
      padding: 12px;
      text-align: center;
      box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    }
    nav a {
      margin: 0 15px;
      text-decoration: none;
      color: #5e2d91;
      font-weight: bold;
    }
    .banner {
      background: #ff9900;
      color: white;
      text-align: center;
      padding: 50px 20px;
    }
    .banner h2 {
      font-size: 28px;
      margin-bottom: 15px;
    }
    .banner button {
      padding: 12px 20px;
      border: none;
      border-radius: 8px;
      background: #5e2d91;
      color: white;
      font-weight: bold;
      cursor: pointer;
    }
    .container {
      width: 90%;
      max-width: 1200px;
      margin: auto;
      padding: 40px 0;
    }
    .section-title {
      font-size: 22px;
      margin-bottom: 20px;
      text-align: center;
      color: #5e2d91;
    }
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 20px;
    }
    .card {
      background: white;
      padding: 15px;
      border-radius: 12px;
      text-align: center;
      box-shadow: 0 2px 6px rgba(0,0,0,0.1);
    }
    .card h3 {
      font-size: 16px;
      margin-bottom: 8px;
    }
    .card p {
      color: #5e2d91;
      font-weight: bold;
      margin-bottom: 10px;
    }
    .card a {
      background: #5e2d91;
      color: white;
      padding: 8px 12px;
      text-decoration: none;
      border-radius: 6px;
      display: inline-block;
    }
    .avisos {
      background: #fff0f5;
      border: 1px solid #5e2d91;
      padding: 20px;
      border-radius: 10px;
      margin: 40px 0;
      text-align: center;
    }
    .avisos p {
      margin: 10px 0;
      font-style: italic;
    }
    footer {
      background: #5e2d91;
      color: white;
      text-align: center;
      padding: 20px;
      margin-top: 40px;
    }
    footer a {
      color: #ffd700;
      text-decoration: none;
    }
  </style>
</head>
<body>
  <header>
    <h1>🌸 Chizuru Sales 🌸</h1>
    <input type="text" placeholder="O que você procura?">
  </header>

  <nav>
    <a href="#avakin">Avakin</a>
    <a href="#crowns">Crowns</a>
    <a href="#streaming">Streaming</a>
    <a href="#ff">Free Fire</a>
    <a href="#robux">Robux</a>
    <a href="#outros">Outros</a>
  </nav>

  <div class="banner">
