    <div class="grid">
      <div class="card"><h3>Spotify Mensal</h3><p>R$15,50</p><a href="#">Comprar</a></div>
      <div class="card"><h3>Canva Pro</h3><p>R$4,60</p><a href="#">Comprar</a></div>
      <div class="card"><h3>Capcut Pro</h3><p>R$10,80</p><a href="#">Comprar</a></div>
