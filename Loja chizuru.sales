    <h2 class="section-title">✨ Avacoins Direto</h2>
    <div class="grid">
      <div class="card"><h3>1.750</h3><p>R$10,59</p><a href="#">Comprar</a></div>
      <div class="card"><h3>3.750</h3><p>R$19,50</p><a href="#">Comprar</a></div>
      <div class="card"><h3>6.750</h3><p>R$33,50</p><a href="#">Comprar</a></div>
