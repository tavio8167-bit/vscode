  </div>

  <div class="container" id="streaming">
    <h2 class="section-title">📺 Telas Streaming</h2>
    <div class="grid">
      <div class="card"><h3>Prime Vídeo</h3><p>R$9,80</p><a href="#">Comprar</a></div>
      <div class="card"><h3>HBO Max</h3><p>R$9,90</p><a href="#">Comprar</a></div>
      <div class="card"><h3>Disney+ Star</h3><p>R$10,98</p><a href="#">Comprar</a></div>
      <div class="card"><h3>Paramount</h3><p>R$9,95</p><a href="#">Comprar</a></div>
