      <div class="card"><h3>Globoplay</h3><p>R$9,70</p><a href="#">Comprar</a></div>
      <div class="card"><h3>Premiere</h3><p>R$9,95</p><a href="#">Comprar</a></div>
      <div class="card"><h3>Viki Rakuten</h3><p>R$9,95</p><a href="#">Comprar</a></div>
    </div>
  </div>

  <div class="container" id="ff">
    <h2 class="section-title">🔥 Diamantes Free Fire</h2>
    <div class="grid">
      <div class="card"><h3>100</h3><p>R$5,50</p><a href="#">Comprar</a></div>
      <div class="card"><h3>310</h3><p>R$16,50</p><a href="#">Comprar</a></div>
      <div class="card"><h3>520</h3><p>R$26,50</p><a href="#">Comprar</a></div>
      <div class="card"><h3>1060</h3><p>R$52,50</p><a href="#">Comprar</a></div>
      <div class="card"><h3>2180</h3><p>R$104,50</p><a href="#">Comprar</a></div>
      <div class="card"><h3>5600</h3><p>R$262,50</p><a href="#">Comprar</a></div>
    </div>
  </div>

  <div class="container" id="robux">
    <h2 class="section-title">💎 Robux</h2>
    <div class="grid">
      <div class="card"><h3>80</h3><p>R$5,50</p><a href="#">Comprar</a></div>
      <div class="card"><h3>400</h3><p>R$25,50</p><a href="#">Comprar</a></div>
